# -------------------------------------------------------------
# SATELLITE INTELLIGENCE - ENVIRONMENT CONFIGURATION TEMPLATE
# -------------------------------------------------------------
# Copy this file to .env and customize as needed:
#   cp .env.example .env
# Note: .env is git-ignored to prevent accidental secret leakage.

# Server Host & Port binding
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=production

# Custom Dataset Path (Optional: Leave blank to use adaptive India 20-City Earth Observation dataset)
# Example: SATELLITE_DATA_PATH=data/sentinel_india_observations.parquet
SATELLITE_DATA_PATH=

# In-Memory Cache TTL (seconds) for analytical query results
CACHE_TTL=300

# Maximum file upload size in megabytes for /api/upload
MAX_UPLOAD_MB=500

# Server logging verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Enable automated fallback ingestion for India regional telemetry
AUTO_DOWNLOAD_INDIA_DATA=true
